{
  "name": "dsh-global-tasks",
  "version": "0.1.0",
  "type": "module",
  "description": "Global running and pending sessions above the native DeepSeek Harness workspace list.",
  "license": "MIT",
  "author": "AnsonLi-better",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnsonLi-better/dsh-global-tasks.git"
  },
  "homepage": "https://github.com/AnsonLi-better/dsh-global-tasks#readme",
  "bugs": {
    "url": "https://github.com/AnsonLi-better/dsh-global-tasks/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "harness-plugin",
    "sessions",
    "tasks"
  ],
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "docs/assets",
    "VALIDATION.md",
    "build.mjs"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "npm run build && node --test test/*.test.mjs && node --check index.js && node --check client.js",
    "prepare": "node -e \"import('esbuild').then(function(){return import('./build.mjs')}).catch(function(){})\""
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-session": "0.2.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-session": {
      "optional": true
    }
  },
  "dependencies": {
    "zod": "4.1.12"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  }
}
